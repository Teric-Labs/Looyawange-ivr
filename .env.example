# Africa's Talking Voice (sandbox first — same app as USSD/SMS)
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_VOICE_NUMBER=

# Public HTTPS origin for AT callbacks + <Play> URLs
# On Render: set to https://looyawange-ivr.onrender.com (or leave unset to use RENDER_EXTERNAL_URL)
IVR_PUBLIC_BASE_URL=https://looyawange-ivr.onrender.com

# Wakilibot agent — SAME as web: knowledge/LLM + ASR (/transcribe) + TTS (/tts)
WAKILIBOT_AGENT_URL=https://wakilibot-agent-0wm0.onrender.com

IVR_DEFAULT_LANGUAGE=en
IVR_HOST=0.0.0.0
IVR_PORT=8088
